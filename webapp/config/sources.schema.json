{
  "$defs": {
    "AreaSpec": {
      "additionalProperties": false,
      "description": "A box around a regional model's domain, in degrees. Inside it the model's\nown answer decides; outside it the source is not asked.",
      "properties": {
        "south": {
          "maximum": 90,
          "minimum": -90,
          "title": "South",
          "type": "number"
        },
        "north": {
          "maximum": 90,
          "minimum": -90,
          "title": "North",
          "type": "number"
        },
        "west": {
          "maximum": 180,
          "minimum": -180,
          "title": "West",
          "type": "number"
        },
        "east": {
          "maximum": 180,
          "minimum": -180,
          "title": "East",
          "type": "number"
        }
      },
      "required": [
        "south",
        "north",
        "west",
        "east"
      ],
      "title": "AreaSpec",
      "type": "object"
    },
    "FixtureSpec": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "const": "fixture",
          "title": "Adapter",
          "type": "string"
        },
        "directory": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recorded forecasts, relative to this file. Default: tests/fixtures.",
          "title": "Directory"
        },
        "area": {
          "anyOf": [
            {
              "$ref": "#/$defs/AreaSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "As the live source it stands in for."
        }
      },
      "required": [
        "adapter"
      ],
      "title": "FixtureSpec",
      "type": "object"
    },
    "OpenMeteoEnsembleSpec": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "const": "open_meteo_ensemble",
          "title": "Adapter",
          "type": "string"
        },
        "model": {
          "default": "ecmwf_ifs025",
          "description": "Open-Meteo's name for the ensemble model.",
          "title": "Model",
          "type": "string"
        },
        "forecast_days": {
          "default": 15,
          "description": "How far ahead to ask; NaN past the run's end is dropped.",
          "maximum": 35,
          "minimum": 1,
          "title": "Forecast Days",
          "type": "integer"
        },
        "timeout_s": {
          "default": 30.0,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Timeout S",
          "type": "number"
        },
        "area": {
          "anyOf": [
            {
              "$ref": "#/$defs/AreaSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For a regional model: the box around its domain. Default: the whole globe."
        }
      },
      "required": [
        "adapter"
      ],
      "title": "OpenMeteoEnsembleSpec",
      "type": "object"
    },
    "ProductSpec": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "description": "What the UI calls it.",
          "title": "Label",
          "type": "string"
        },
        "ensemble": {
          "description": "Key of the ensemble source under `sources`.",
          "title": "Ensemble",
          "type": "string"
        },
        "schemes": {
          "description": "VSUP schemes from vsup.yaml, at most one per variable.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Schemes",
          "type": "array"
        },
        "variables": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "temperature_2m",
                  "precipitation",
                  "cloud_cover",
                  "wind_speed_10m"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What to fetch. Default: everything the source delivers.",
          "title": "Variables"
        },
        "members": {
          "description": "Ensemble members the model runs.",
          "minimum": 10,
          "title": "Members",
          "type": "integer"
        },
        "grid_km": {
          "description": "Grid spacing of the model, in km.",
          "exclusiveMinimum": 0,
          "title": "Grid Km",
          "type": "number"
        },
        "horizon_days": {
          "description": "About how far ahead a run reaches, in days.",
          "exclusiveMinimum": 0,
          "title": "Horizon Days",
          "type": "number"
        },
        "automatic": {
          "default": true,
          "description": "Whether the automatic choice may take it (sources/choice.py); it stays selectable by hand.",
          "title": "Automatic",
          "type": "boolean"
        },
        "steps": {
          "default": [
            6
          ],
          "description": "Step widths in hours it can be drawn in, the first the default. Each must divide a day; offer 1 only for a model that really computes every hour.",
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "label",
        "ensemble",
        "schemes",
        "members",
        "grid_km",
        "horizon_days"
      ],
      "title": "ProductSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    },
    "sources": {
      "additionalProperties": {
        "discriminator": {
          "mapping": {
            "fixture": "#/$defs/FixtureSpec",
            "open_meteo_ensemble": "#/$defs/OpenMeteoEnsembleSpec"
          },
          "propertyName": "adapter"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/OpenMeteoEnsembleSpec"
          },
          {
            "$ref": "#/$defs/FixtureSpec"
          }
        ]
      },
      "minProperties": 1,
      "title": "Sources",
      "type": "object"
    },
    "products": {
      "additionalProperties": {
        "$ref": "#/$defs/ProductSpec"
      },
      "description": "The first one is the default.",
      "minProperties": 1,
      "title": "Products",
      "type": "object"
    }
  },
  "required": [
    "version",
    "sources",
    "products"
  ],
  "title": "Forecast sources and products",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
