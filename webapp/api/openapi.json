  "info": {
    "description": "Probabilistic forecasts as quantiles plus VSUP pictograms. Read-only.",
    "title": "VSUP meteogram API",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/forecast": {
      "get": {
        "description": "The whole forecast the source has - the client picks the days it shows -\nas quantiles per step plus the product's pictograms.",
        "operationId": "forecast_api_forecast_get",
        "parameters": [
          {
            "description": "Rounded to 2 decimals.",
            "in": "query",
            "name": "lat",
            "required": true,
            "schema": {
              "description": "Rounded to 2 decimals.",
              "maximum": 90,
              "minimum": -90,
              "title": "Lat",
              "type": "number"
            }
          },
          {
            "description": "Rounded to 2 decimals.",
            "in": "query",
            "name": "lon",
            "required": true,
            "schema": {
              "description": "Rounded to 2 decimals.",
              "maximum": 180,
              "minimum": -180,
              "title": "Lon",
              "type": "number"
            }
          },
          {
            "description": "A product id from /api/products; default: the first.",
            "in": "query",
            "name": "product",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A product id from /api/products; default: the first.",
              "title": "Product"
            }
          },
          {
            "in": "query",
            "name": "variant",
            "required": false,
            "schema": {
              "default": "ensemble",
              "enum": [
                "ensemble",
                "hres"
              ],
              "title": "Variant",
              "type": "string"
            }
          },
          {
            "description": "Put into location.name as given.",
            "in": "query",
            "name": "name",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Put into location.name as given.",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Forecast"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "The source has no data for this place."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "The product lacks this variant."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "The upstream source failed or sent unusable data."
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "The upstream source did not answer in time."
          }
        },
        "summary": "Forecast",
        "tags": [
          "forecast"
        ]
      }
    },
    "/api/geocode": {
      "get": {
        "description": "Places matching `q`, best first; an empty list rather than an error\nwhen nothing matches. Fine to call while the user types.",
        "operationId": "geocode_api_geocode_get",
        "parameters": [
          {
            "description": "Place name; fewer than 2 characters find nothing.",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "Place name; fewer than 2 characters find nothing.",
              "maxLength": 100,
              "minLength": 1,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "lang",
            "required": false,
            "schema": {
              "default": "en",
              "enum": [
                "de",
                "en"
              ],
              "title": "Lang",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "count",
            "required": false,
            "schema": {
              "default": 5,
              "maximum": 20,
              "minimum": 1,
              "title": "Count",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeocodeOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "The source has no data for this place."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "The upstream source failed or sent unusable data."
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "The upstream source did not answer in time."
          }
        },
        "summary": "Geocode",
        "tags": [
          "forecast"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Liveness. With deep=true, also fetches from every source, uncached.",
        "operationId": "health_api_health_get",
        "parameters": [
          {
            "in": "query",
