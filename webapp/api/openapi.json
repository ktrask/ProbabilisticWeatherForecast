    "/api/schemes": {
      "get": {
        "description": "Every loaded VSUP scheme with every pictogram it can choose - enough\nto draw a legend that always matches the rules.",
        "operationId": "list_schemes_api_schemes_get",
        "responses": {
          "200": {
